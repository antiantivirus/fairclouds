---
// Don't prerender as this page will be unique for each user.
export const prerender = false;

import directus from "../../../lib/directus";
import { readItems } from "@directus/sdk";
import Layout from "../../../layouts/Layout.astro";
import Blog from "../../../components/Blog.astro";

const { lang, slug } = Astro.params;

if (!lang || !["en", "es"].includes(lang)) {
	return Astro.redirect("/en");
}

const articleResults = await directus.request(
	readItems("articles", {
		filter: {
			slug: {
				_eq: slug,
			},
		},
		deep: {
			translations: {
				_filter: {
					languages_code: {
						_eq: lang,
					},
				},
			},
		},
		fields: ["*", { translations: ["*"] }],
		limit: 1,
	}),
);

const article = articleResults[0];

if (!article || !article.translations?.length) {
	throw new Error("Article not found");
}
const page = {
	image: article.image,
	date: article.date_created,
	translation: article.translations[0],
};

const articles = await directus.request(
  readItems("articles", {
    deep: {
      translations: {
        _filter: {
          _and: [
            {
              languages_code: { _eq: lang },
            },
          ],
        },
      },
    },
    fields: ["*", { translations: ["*"] }],
  }),
);
---

<Layout title="Fairclouds" theme="white">
  <Blog articles={articles} article={page} lang={lang} />
</Layout>
