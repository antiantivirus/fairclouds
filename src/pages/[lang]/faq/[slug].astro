---
export const prerender = false;

import directus from "../../../lib/directus";
import { readItems } from "@directus/sdk";
import Layout from "../../../layouts/Layout.astro";
import FAQSidebar from "../../../components/FAQSidebar.astro";
import Blocks from "../../../components/Blocks.astro";

const { lang, slug } = Astro.params;

if (!lang || !["en", "es"].includes(lang)) {
	return Astro.redirect("/en");
}

const pageResults = await directus.request(
	readItems("wiki", {
		filter: {
			slug: {
				_eq: slug,
			},
		},
		deep: {
			translations: {
				_filter: {
					languages_code: {
						_eq: lang,
					},
				},
			},
		},
		fields: ["*", { translations: ["*"] }],
		limit: 1,
	}),
);
const page = pageResults[0];

if (!page || !page.translations?.length) {
	throw new Error("Page not found");
}
const translation = page.translations[0];

const pages = await directus.request(
	readItems("wiki", {
		deep: {
			translations: {
				_filter: {
					languages_code: {
						_eq: lang,
					},
				},
			},
		},
		fields: ["*", { translations: ["*"] }],
	}),
);
---

<Layout title="Fairclouds" theme="white">
  <div class="flex gap-28 justify-between px-4 py-2.5">
    <FAQSidebar pages={pages} lang={lang} />
    <main class="grow">
      <h1>{translation.title}</h1>
      {
        translation.content?.blocks && (
          <Blocks content={translation.content.blocks} />
        )
      }
    </main>
  </div>
</Layout>
